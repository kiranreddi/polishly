<Window x:Class="Polishly.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Welcome to Polishly"
        Width="700" Height="520"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Polishly.App;component/Themes/PolishlyTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#0B1626" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="58" Height="58" CornerRadius="15" ClipToBounds="True" HorizontalAlignment="Left">
                        <Image Source="/Polishly.App;component/Assets/BrandMark.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Polishly" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <TextBlock Text="A quieter, faster way to write well everywhere."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SETUP PROGRESS" Margin="0,0,0,12"/>
                    <ProgressBar Minimum="0" Maximum="6" Value="{Binding CurrentStep}"/>
                    <TextBlock Text="{Binding CurrentStep, StringFormat='Step {0} of 6'}"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,9,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Private by default" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11.5"/>
                    <TextBlock Text="Nothing is read until you trigger Polishly."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="40,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding StepTitle}" FontFamily="{StaticResource DisplayFont}"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StepDescription}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,28,0,28">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="78" Height="78" CornerRadius="22" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,18">
                        <TextBlock Text="P" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Select text. Press Ctrl + Shift + P."
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="Review the live diff, then accept or revise."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,7,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Back" Command="{Binding PreviousStepCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="92"/>
                <Button Grid.Column="2" Content="{Binding NextButtonText}" Command="{Binding NextStepCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="112"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
