<Window x:Class="Polishly.App.Views.ReviseInstructionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Revise with Polishly"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Width="480" Height="290"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Polishly.App;component/Themes/PolishlyTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" ClipToBounds="True" Margin="0,0,12,0">
                    <Image Source="/Polishly.App;component/Assets/BrandMark.png" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Revise the rewrite" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Tell Polishly what should feel different." Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="1" x:Name="InstructionTextBox"
                     Text="{Binding InstructionText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Padding="13,11" Margin="0,0,0,18"
                     ToolTip="For example: make it warmer and more concise"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Enter to submit · Esc to cancel" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10.5" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Revise" Command="{Binding SubmitCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
