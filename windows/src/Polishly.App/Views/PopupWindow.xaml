<Window x:Class="Polishly.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Polishly"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        AutomationProperties.Name="Polishly rewrite review"
        SizeToContent="Height"
        Width="470" MaxWidth="560">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Polishly.App;component/Themes/PolishlyTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="PopupBorder"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.46" Color="#020914"/>
        </Border.Effect>

        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,11,0">
                    <Grid>
                        <TextBlock Text="P" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,1,0,0"/>
                        <TextBlock Text="✦" Foreground="{StaticResource AccentHoverBrush}" FontSize="8"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,3,0"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Polishly" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding StateDescription}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                </StackPanel>
                <Button Grid.Column="2" Content="×" Command="{Binding DismissCommand}"
                        Style="{StaticResource TitleBarButtonStyle}" Width="34" Height="34"/>
            </Grid>

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="15">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DiffTextBlock"
                               FontSize="13.5"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </ScrollViewer>
            </Border>

            <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ctrl + Shift + P" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Revise" Command="{Binding OpenReviseCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,7" MinHeight="34" AutomationProperties.Name="Revise with custom instructions"/>
                    <Button Content="Copy" Command="{Binding CopyCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,7" MinHeight="34" AutomationProperties.Name="Copy rewrite without replacing"/>
                    <Button Content="Retry" Command="{Binding RetryCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,7" MinHeight="34" AutomationProperties.Name="Regenerate rewrite"/>
                    <Button Content="Accept" Command="{Binding AcceptCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="15,7" MinHeight="34" AutomationProperties.Name="Accept and replace selected text"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
