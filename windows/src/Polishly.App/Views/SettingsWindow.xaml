<Window x:Class="Polishly.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="Polishly - Settings"
        Width="820" Height="720"
        MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Polishly.App;component/Themes/PolishlyTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="7"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A1627" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                            <Grid>
                                <TextBlock Text="P" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,1,0,0"/>
                                <TextBlock Text="✦" Foreground="{StaticResource AccentHoverBrush}" FontSize="9"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,3,0"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Polishly" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Windows companion settings" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="—" Click="MinimizeButton_Click"
                                automation:AutomationProperties.Name="Minimize"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="□" Click="MaximizeButton_Click"
                                automation:AutomationProperties.Name="Maximize or restore"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="×" Click="CloseButton_Click"
                                automation:AutomationProperties.Name="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,28,32,30">
                    <Grid Margin="2,0,2,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="POLISHLY FOR WINDOWS"/>
                            <TextBlock Text="Write with confidence, anywhere."
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,7,0,6"/>
                            <TextBlock Text="Choose your AI provider and tune how Polishly works across your apps."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="10"
                                Padding="13,8" VerticalAlignment="Center" Margin="20,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Ready in the tray" Foreground="{StaticResource AccentBrush}"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="AI provider"/>
                                    <TextBlock Text="Your key never leaves Windows Credential Manager except for provider requests."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="10,6">
                                    <TextBlock Text="SECURE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.42*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="0.58*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Provider"/>
                                    <ComboBox ItemsSource="{Binding AvailableProviders}"
                                              SelectedItem="{Binding ActiveProviderId}"
                                              automation:AutomationProperties.Name="AI provider"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="API key"/>
                                    <PasswordBox x:Name="ApiKeyBox"
                                                 PasswordChanged="ApiKeyBox_PasswordChanged"
                                                 automation:AutomationProperties.Name="API key"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding ValidationStatus}" Foreground="{StaticResource AccentBrush}" FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Workflow"/>
                            <TextBlock Text="Keep Polishly close without letting it get in your way."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,4,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.55*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="0.45*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Global hotkey"/>
                                    <TextBox Text="{Binding HotkeyShortcut, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Global hotkey"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Appearance"/>
                                    <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding Theme}"
                                              automation:AutomationProperties.Name="Theme"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Launch with Windows" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Start quietly in the notification area when you sign in."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LaunchAtStartup}" VerticalAlignment="Center"
                                              automation:AutomationProperties.Name="Launch Polishly at Windows startup"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Protected applications"/>
                            <TextBlock Text="Polishly will never activate inside apps on this list."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,4,0,18"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewBlockedAppName, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Application to block"/>
                                <Button Grid.Column="2" Content="Add app" Command="{Binding AddBlocklistCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>

                            <ListBox ItemsSource="{Binding BlockedApplications}" MinHeight="86" MaxHeight="150">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" Background="{StaticResource DangerSoftBrush}" CornerRadius="7" Margin="0,0,10,0">
                                                <TextBlock Text="×" Foreground="{StaticResource DangerBrush}" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" FontSize="12.5"/>
                                            <Button Grid.Column="2" Content="Remove"
                                                    Command="{Binding DataContext.RemoveBlocklistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    MinHeight="30" Padding="10,4" FontSize="10.5"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#0B1626" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Private by design" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Text is sent only when you press your hotkey."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Save settings" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="118" Height="40" MinHeight="0" Padding="12,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
